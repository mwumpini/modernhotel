# Environment Variables Template (Vercel/Any Platform)
# Copy this to .env.local for local development.
# In Vercel, set these in Project Settings → Environment Variables.

# Database Configuration (optional unless you use Prisma-backed features)
# Provide a PostgreSQL connection string if enabling the production DB.
DATABASE_URL="postgresql://username:password@host:port/database"

# NextAuth Configuration
# In Vercel, set NEXTAUTH_URL to your deployment URL (e.g., https://your-app.vercel.app)
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="https://your-app.vercel.app"

# Optional: Analytics and App URL
# Set to your deployed URL (used by links, notifications, etc.)
NEXT_PUBLIC_ANALYTICS_ID=""
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Optional: Email Configuration (if you add email features later)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Optional: Payment Gateway (if you add payment features later)
STRIPE_PUBLIC_KEY=""
STRIPE_SECRET_KEY=""

# AI (OpenAI-compatible)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL="gpt-4o-mini"
NEXT_PUBLIC_AI_LOCAL_ONLY="false"