  "templates": {
    "ghana_sales_standard": {
      "meta": {
        "title": "Ghana Sales (VAT+Levies)",
        "domain": "sales",
        "operation": "external",
        "effect": "all"
      },
      "rules": [
        {
          "name": "NHIL",
          "rate": 2.5,
          "glCode": "2120",
          "appliesTo": [
            "ALL"
          ],
          "description": "National Health Insurance Levy — 2.5% of the taxable value. Claimable on purchases (Act 1151).",
          "enabled": true,
          "priority": 10,
          "calculationBase": "subtotal",
          "method": "rate",
          "stacking": "additive",
          "rounding": "nearest",
          "roundTo": 0.01,
          "domain": "sales",
          "operation": "external",
          "effect": "add",
          "isRecoverable": true
        },
        {
          "name": "GETFund Levy",
          "rate": 2.5,
          "glCode": "2130",
          "appliesTo": [
            "ALL"
          ],
          "description": "Ghana Education Trust Fund Levy — 2.5% of the same taxable value. Claimable on purchases (Act 1151).",
          "enabled": true,
          "priority": 11,
          "calculationBase": "subtotal",
          "method": "rate",
          "stacking": "additive",
          "rounding": "nearest",
          "roundTo": 0.01,
          "domain": "sales",
          "operation": "external",
          "effect": "add",
          "isRecoverable": true
        },
        {
          "name": "VAT (Standard Rate)",
          "rate": 15,
          "glCode": "2110",
          "appliesTo": [
            "ALL"
          ],
          "description": "VAT 15% of the same taxable value as NHIL and GETFund (Act 1151).",
          "enabled": true,
          "priority": 20,
          "calculationBase": "subtotal",
          "method": "rate",
          "stacking": "additive",
          "rounding": "nearest",
          "roundTo": 0.01,
          "domain": "sales",
          "operation": "external",
          "effect": "add",
          "isRecoverable": true
        },
        {
          "name": "Tourism Levy",
          "rate": 1,
