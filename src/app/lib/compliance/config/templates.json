    "GH": {
      "templateKey": "ghana_sales_standard",
      "note": "Act 1151 (Jan 2026): VAT 15% + NHIL 2.5% + GETFund 2.5% = 20% on taxable value; Tourism 1% separate (~21% on hotel bills)."
    }
  },
  "templates": {
    "ghana_sales_standard": {
      "meta": {
        "title": "Ghana Sales (VAT+Levies)",
        "domain": "sales",
        "operation": "external",
        "effect": "all"
      },
      "rules": [
        { "name": "NHIL", "rate": 2.5, "glCode": "2120", "appliesTo": ["ALL"], "description": "National Health Insurance Levy", "enabled": true, "priority": 10, "calculationBase": "subtotal", "method": "rate", "stacking": "additive", "rounding": "nearest", "roundTo": 0.01, "domain": "sales", "operation": "external", "effect": "add" },
        { "name": "GETFund Levy", "rate": 2.5, "glCode": "2130", "appliesTo": ["ALL"], "description": "Ghana Education Trust Fund Levy", "enabled": true, "priority": 11, "calculationBase": "subtotal", "method": "rate", "stacking": "additive", "rounding": "nearest", "roundTo": 0.01, "domain": "sales", "operation": "external", "effect": "add" },
        { "name": "VAT (Standard Rate)", "rate": 15, "glCode": "2110", "appliesTo": ["ALL"], "description": "VAT 15% on (subtotal + NHIL + GETFund) — Act 1151, Jan 2026", "enabled": true, "priority": 20, "calculationBase": "subtotal_plus_applied", "method": "rate", "stacking": "compound", "rounding": "nearest", "roundTo": 0.01, "domain": "sales", "operation": "external", "effect": "add" },
        { "name": "Tourism Levy", "rate": 1, "glCode": "2150", "appliesTo": ["ROOM", "HOTEL", "FOOD"], "description": "Tourism Development Levy (L.I. 2185)", "enabled": true, "priority": 30, "calculationBase": "subtotal", "method": "rate", "stacking": "additive", "rounding": "nearest", "roundTo": 0.01, "domain": "sales", "operation": "external", "effect": "add" }
      ]
    },
