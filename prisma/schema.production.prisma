// Production Prisma Schema for Railway Deployment
// This is a backup schema that uses PostgreSQL
// Your current SQLite schema will continue to work locally

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

