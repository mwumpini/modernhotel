// Append-only audit trail of every stock movement. InventoryItem.quantityOnHand
// is the running total this log produces — always write both together in one
// transaction so the two never drift apart.
model InventoryTransaction {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  locationId    String?
  type          String   // receipt | issue | transfer_in | transfer_out | adjustment | count
  quantity      Decimal  @db.Decimal(10, 3) // signed: positive adds to stock, negative removes
  unitCost      Decimal? @db.Decimal(10, 2)
  referenceType String?  // purchase_order | requisition | transfer | stock_count | manual
  referenceId   String?
  notes         String?
  performedBy   String?
  createdAt     DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId, itemId])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

