  route         String   @default("kitchen") // kitchen | bar
  unitPrice     Decimal
  costPrice     Decimal  @default(0)
  glAccountCode String   @default("4200")
  isAvailable   Boolean  @default(true)
  allergens     String?
  prepMinutes   Int      @default(10)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, venue])
  @@index([tenantId, category])
  @@map("fb_menu_items")
}

model FBOrder {
  id           String      @id @default(cuid())
  tenantId     String
  orderNumber  String
  venue        String      // restaurant | bar | room_service | pool_bar
  status       String      @default("pending") // pending | preparing | ready | served | cancelled | billed
  tableNumber  String?
  roomNumber   String?
  guestId      String?
  reservationId String?
  folioId      String?     // set when billed to folio
  serverName   String?
  covers       Int         @default(1)
  subtotal     Decimal     @default(0)
  taxAmount    Decimal     @default(0)
  total        Decimal     @default(0)
  taxLines     Json?       // stores per-tax breakdown: [{taxCode, name, rate, amount, glAccountCode}]
  discountAmount Decimal   @default(0)
  serviceCharge  Decimal   @default(0)
  notes        String?
  priority     String      @default("normal") // low | normal | high | urgent
  assignedToId   String?
  assignedToName String?
  preparingAt    DateTime?
  billedAt     DateTime?
  servedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  FBOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, guestId])
  @@index([tenantId, folioId])
  @@map("fb_orders")
}

model FBOrderItem {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  menuItemId  String?
  name        String
  category    String?
  route       String   @default("kitchen") // kitchen | bar — drives KDS station routing
  quantity    Int
  unitPrice   Decimal
  amount      Decimal
  taxAmount   Decimal  @default(0)
  notes       String?
  glAccountCode String? @default("4200")
  createdAt   DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  FBOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("fb_order_items")
}

// ─── Housekeeping ─────────────────────────────────────────────────────────────

model HousekeepingTask {
  id           String    @id @default(cuid())
  tenantId     String
  roomId       String?
  roomNumber   String?
  taskType     String    // cleaning | inspection | turndown | maintenance | deep_clean
  status       String    @default("pending") // pending | in_progress | completed | skipped
  priority     String    @default("normal")  // low | normal | high | urgent
  assignedTo   String?
  assignedName String?
  notes        String?
  scheduledFor DateTime?
  startedAt    DateTime?
