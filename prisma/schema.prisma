// Field names/status vocabulary deliberately match src/app/lib/inventory/models.ts's
// PurchaseOrder/PurchaseOrderItem (the shape the actual UI in supplierStore.ts uses),
// not a generic invented shape — so the store's create/update calls map 1:1 with no
// lossy translation layer.
model PurchaseOrder {
  id                   String    @id @default(cuid())
  tenantId             String
  poNumber             String
  // Loose reference to the inventory module's Supplier record (currently a separate
  // in-memory store, not this schema's Supplier table) — not a Prisma FK on purpose.
  supplierId           String
  supplierName         String
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  status               String    @default("draft") // draft|sent|confirmed|in-transit|delivered|cancelled|closed
  priority             String    @default("medium") // low|medium|high|urgent
  totalAmount          Decimal   @default(0) // pre-tax/shipping/discount subtotal
  // Signed — positive when the selected tax type nets to an add (e.g. VAT), negative
  // when it nets to a withholding. Computed by summing every rule assigned to the
  // selected Tax Type via the shared stacking engine (computeTaxStack).
  taxAmount            Decimal   @default(0)
  // Which compliance Tax Type (Settings → Tax Rate Builder — a named bundle of rules,
  // e.g. "Purchases Standard Tax" = NHIL+GETFund+VAT, "Purchases Flat Rate" = VFRS 3%)
  // was selected; null = none. 'custom' = a manually typed override rate.
  taxTypeId            String?
  shippingAmount       Decimal   @default(0)
  discountAmount       Decimal   @default(0)
  finalAmount          Decimal   @default(0)
  currency             String    @default("GHS")
  paymentTerms         String?
  notes                String?
  createdBy            String?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  tenantId         String
  purchaseOrderId  String
  itemId           String
  itemCode         String
  itemName         String
  quantity         Decimal
  unitCost         Decimal
  totalCost        Decimal
  receivedQuantity Decimal  @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model Requisition {
