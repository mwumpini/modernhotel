// ---------------------------------------------------------------------------
// Compliance filing status -- tenant-scoped record of "did THIS tenant submit
// its VAT/PAYE/SSNIT/etc return for this period", distinct from the shared
// (non-tenant-scoped) tax-rule/reporting-schedule reference data still served
// from prisma/compliance.*.json via ComplianceDB. Previously this lived only
// in the compliance Zustand store's in-memory `reports` array -- populated by
// upsertReport() from payroll/tax-remittance sync and by manual Submit/
// Approve clicks in ComplianceReportsPanel.tsx, but never persisted, so both
// the auto-synced entries and manual status changes vanished on reload.
// ---------------------------------------------------------------------------

model ComplianceReport {
  id            String   @id @default(cuid())
  tenantId      String
  countryCode   String
  reportType    String
  period        String // e.g. "2026-01"
  dueDate       String // ISO date string (YYYY-MM-DD), matches the store's ComplianceReport type
  status        String   @default("pending") // pending|submitted|approved|rejected
  amount        Float    @default(0)
  currency      String   @default("GHS")
  submittedDate String?
  notes         String?
  attachments   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, countryCode, reportType, period])
  @@index([tenantId, countryCode])
  @@map("compliance_report_filings")
}

// ---------------------------------------------------------------------------
// Compliance tax configuration -- rates/rules, tax types, and filing-schedule
// reference data. Previously all three lived in shared, non-tenant-scoped flat
// JSON files (prisma/compliance.*.json via ComplianceDB) with no tenantId
// anywhere: every tenant on the deployment read and wrote the SAME file, and
// on Vercel those files live under ephemeral /tmp -- wiped on every cold start
// and redeploy. A tenant customizing e.g. a tax rule's name or rate had that
// change both visible to every other tenant and silently discarded on the
// next deploy. Each row's full shape (rate, glCode, tiers, scope, condition,
// etc.) is kept as a JSON blob under `data` rather than normalized into ~20
// mostly-optional columns, matching the JSON long-tail convention already
// used for HrEmployee.details/Supplier.details -- `code` is the stable
// client-facing identity (e.g. "gh-vat") used for upsert/reference, separate
// from the DB's own `id`.
// ---------------------------------------------------------------------------

model ComplianceTaxRule {
  id          String   @id @default(cuid())
  tenantId    String
  countryCode String
  code        String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, countryCode])
  @@map("compliance_tax_rules")
}

model ComplianceTaxType {
  id          String   @id @default(cuid())
  tenantId    String
  countryCode String
  code        String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, countryCode])
  @@map("compliance_tax_types")
}

model ComplianceReportingRule {
  id          String   @id @default(cuid())
  tenantId    String
  countryCode String
  code        String
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, countryCode])
  @@map("compliance_reporting_rules")
}

