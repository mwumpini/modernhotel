}

model PettyCashFund {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  currencyId String
  balance    Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency     Currency       @relation(fields: [currencyId], references: [id])
  transactions PettyCashTxn[]

  @@unique([tenantId, name])
  @@map("petty_cash_funds")
}

model PettyCashTxn {
  id          String   @id @default(cuid())
  tenantId    String
  fundId      String
  type        String
  amount      Decimal
  date        DateTime @default(now())
  reference   String?
  description String?
  voucherId   String?

  // Relations
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fund    PettyCashFund   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  voucher ExpenseVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@map("petty_cash_txns")
}

// ─── F&B / POS ────────────────────────────────────────────────────────────────

model FBMenuItem {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
