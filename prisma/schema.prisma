// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  subdomain     String   @unique
  plan          String   @default("starter")
  status        String   @default("active")
  maxUsers      Int      @default(5)
  maxRooms      Int      @default(20)
  maxProperties Int      @default(1)
  features      Json
  metadata      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users             User[]
  properties        Property[]
  settings          SystemSettings[]
  guests            Guest[]
  reservations      Reservation[]
  auditLogs         AuditLog[]
  rooms             Room[]
  companies         Company[]
  suppliers         Supplier[]
  units             UnitOfMeasure[]
  itemCategories    ItemCategory[]
  inventoryItems    InventoryItem[]
  stockLocations    StockLocation[]
  currencies        Currency[]
  exchangeRates     ExchangeRate[]
  accounts          Account[]
  taxes             Tax[]
  folios            Folio[]
  folioLines        FolioLine[]
  payments          Payment[]
  paymentMethods    PaymentMethod[]
  expenseVouchers   ExpenseVoucher[]
  expenseLines      ExpenseLine[]
  pettyCashFunds    PettyCashFund[]
  pettyCashTxns     PettyCashTxn[]
  journalEntries    JournalEntry[]
  journalEntryLines JournalEntryLine[]
  accountingInvoices     AccountingInvoice[]
  accountingInvoiceLines AccountingInvoiceLine[]
  accountingPayments     AccountingPayment[]
  guestFolios            GuestFolio[]
  fbMenuItems            FBMenuItem[]
  fbOrders               FBOrder[]
  fbOrderItems           FBOrderItem[]
  housekeepingTasks      HousekeepingTask[]
  roomStatusLogs         RoomStatusLog[]
  maintenanceRequests    MaintenanceRequest[]

  @@map("tenants")
}

model User {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  name        String
  password    String?
  role        String    @default("user")
  permissions Json      @default("[]")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model Property {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  address    String
  city       String
  state      String
  country    String   @default("Ghana")
  postalCode String?
  phone      String?
  email      String?
  website    String?
  timezone   String   @default("Africa/Accra")
  currency   String   @default("GHS")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms           Room[]
  stockLocations  StockLocation[]
  folios          Folio[]
  expenseVouchers ExpenseVoucher[]

  @@unique([tenantId, name])
  @@map("properties")
}

model Guest {
  id           String  @id @default(cuid())
  tenantId     String
  serialNumber String  @unique
  name         String
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  nationality  String?
  ghanaCard    String?
  idType       String?
  idNumber     String?
  vipStatus    String?

  // Long-tail fields (preferences, emergencyContact, address, billing contact,
  // credit fields, dateOfBirth, gender, etc.)
  details Json?

  // Relations
  reservations Reservation[]
  folios       Folio[]

  // Marketing attribution
  source          String?
  referralGuestId String?
  referralName    String?
  socialPlatform  String?
  socialHandle    String?
  campaignCode    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("guests")
}

model Reservation {
  id              String   @id @default(cuid())
  tenantId        String
  guestId         String
  resId           String?
  roomType        String?
  ratePlanId      String?
  roomId          String?
  status          String   @default("pending")
  source          String?
  checkInDate     DateTime
  checkOutDate    DateTime
  adults          Int      @default(1)
  children        Int      @default(0)
  specialRequests String?

  // Hybrid: queryable/reportable columns
  stayReason          String?
  isGuaranteed        Boolean @default(false)
  billingPersonId     String?
  companyName         String?
  groupId             String?
  isGroupLeader       Boolean @default(false)
  linkedReservationId String?
  groupSize           Int?
  totalAmount         Float?

  // Long-tail fields (rateBreakdown, marketCodes, internalNotes, remarksToGuest,
  // projectCode, costCenter, stayReasonDetails, etc.)
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, checkInDate])
  @@index([tenantId, guestId])
  @@index([tenantId, roomId])
  @@index([tenantId, groupId])
  @@map("reservations")
}

model JournalEntry {
  id                  String    @id @default(cuid())
  tenantId            String
  entryNumber         String
  date                DateTime
  reference           String?
  description         String?
  totalDebit          Float     @default(0)
  totalCredit         Float     @default(0)
  currency            String    @default("GHS")
  exchangeRate        Float?
  status              String    @default("Draft")
  postedBy            String?
  postedAt            DateTime?
  sourceModule        String?
  sourceTransactionId String?
  details             Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  JournalEntryLine[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, sourceModule])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountCode    String
  description    String?
  debit          Float   @default(0)
  credit         Float   @default(0)
  currency       String  @default("GHS")
  exchangeRate   Float?
  taxCode        String?
  taxAmount      Float?
  department     String?
  project        String?
  costCenter     String?
  reference      String?
  details        Json?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, accountCode])
  @@map("journal_entry_lines")
}

model AccountingInvoice {
  id                String    @id @default(cuid())
  tenantId          String
  invoiceNumber     String
  type              String    @default("Sales")
  date              DateTime
  dueDate           DateTime?
  businessPartnerId String?
  reference         String?
  description       String?
  subtotal          Float     @default(0)
  taxAmount         Float     @default(0)
  total             Float     @default(0)
  currency          String    @default("GHS")
  exchangeRate      Float?
  status            String    @default("Draft")
  paidAmount        Float     @default(0)
  paidDate          DateTime?
  journalEntryId    String?
  sourceModule      String?
  details           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  AccountingInvoiceLine[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, businessPartnerId])
  @@map("accounting_invoices")
}

model AccountingInvoiceLine {
  id            String  @id @default(cuid())
  tenantId      String
  invoiceId     String
  itemCode      String?
  description   String?
  quantity      Float   @default(0)
  unitPrice     Float   @default(0)
  amount        Float   @default(0)
  taxCode       String?
  taxAmount     Float   @default(0)
  glAccountCode String?
  costCenter    String?
  project       String?
  uom           String?
  taxRate       Float?
  details       Json?

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice AccountingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("accounting_invoice_lines")
}

model AccountingPayment {
  id                String    @id @default(cuid())
  tenantId          String
  paymentNumber     String
  date              DateTime
  type              String    @default("Receipt")
  businessPartnerId String?
  invoiceId         String?
  reference         String?
  description       String?
  amount            Float     @default(0)
  currency          String    @default("GHS")
  exchangeRate      Float?
  paymentMethod     String?
  bankAccountId     String?
  checkNumber       String?
  status            String    @default("Draft")
  journalEntryId    String?
  details           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, invoiceId])
  @@map("accounting_payments")
}

// Front-office guest folio (in-house subledger). The store's Folio carries a
// small set of scalar fields plus charge/payment arrays that mutate frequently;
// arrays live in JSON columns so each folio is a single, atomically-upserted row.
// Named GuestFolio to avoid colliding with the legacy normalized Folio model.
model GuestFolio {
  id               String   @id
  tenantId         String
  reservationId    String
  currency         String   @default("GHS")
  status           String   @default("active")
  type             String?
  description      String?
  responsibleParty String?
  creditBalance    Float?
  totalCharges     Float    @default(0)
  totalPayments    Float    @default(0)
  balance          Float    @default(0)
  charges          Json?
  payments         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, reservationId])
  @@index([tenantId, status])
  @@map("guest_folios")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, action])
  @@map("audit_logs")
}

model SystemSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  // General settings
  generalSettings Json

  // Hotel settings
  hotelSettings Json

  // Room settings
  roomSettings Json

  // Financial settings
  financialSettings Json

  // Client settings
  clientSettings Json

  // SaaS settings
  saasSettings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("system_settings")
}

model Room {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  roomNumber String
  roomType   String
  floor      Int
  features   Json
  status     String   @default("clean")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId, roomNumber])
  @@map("rooms")
}

model Company {
  id             String   @id @default(cuid())
  tenantId       String
  code           String
  name           String
  email          String?
  phone          String?
  taxNumber      String?
  billingAddress Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folios Folio[]

  @@unique([tenantId, code])
  @@map("companies")
}

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  email         String?
  phone         String?
  contactPerson String?
  taxNumber     String?
  address       Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseVouchers ExpenseVoucher[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  precision Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@unique([tenantId, code])
  @@map("units")
}

model ItemCategory {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ItemCategory?   @relation("CategoryToParent", fields: [parentId], references: [id])
  children ItemCategory[]  @relation("CategoryToParent")
  items    InventoryItem[]

  @@unique([tenantId, code])
  @@map("item_categories")
}

model InventoryItem {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  name         String
  description  String?
  categoryId   String?
  unitId       String?
  isPerishable Boolean  @default(false)
  isSerialized Boolean  @default(false)
  barcode      String?
  defaultCost  Decimal?
  sellingPrice Decimal?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category ItemCategory?  @relation(fields: [categoryId], references: [id])
  unit     UnitOfMeasure? @relation(fields: [unitId], references: [id])

  @@unique([tenantId, code])
  @@map("inventory_items")
}

model StockLocation {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String?
  code       String
  name       String
  type       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("stock_locations")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Currency {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  symbol        String?
  decimalPlaces Int      @default(2)
  isBase        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exchangeRatesFrom ExchangeRate[]   @relation("ExchangeFrom")
  exchangeRatesTo   ExchangeRate[]   @relation("ExchangeTo")
  folios            Folio[]
  payments          Payment[]
  expenseVouchers   ExpenseVoucher[]
  pettyCashFunds    PettyCashFund[]

  @@unique([tenantId, code])
  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(cuid())
  tenantId       String
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal
  validFrom      DateTime
  createdAt      DateTime @default(now())

  // Relations
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency Currency @relation("ExchangeFrom", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ExchangeTo", fields: [toCurrencyId], references: [id])

  @@unique([tenantId, fromCurrencyId, toCurrencyId, validFrom])
  @@index([tenantId, validFrom])
  @@map("exchange_rates")
}

model Account {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  parentId  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountParent", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountParent")
  folioLines   FolioLine[]
  expenseLines ExpenseLine[]

  @@unique([tenantId, code])
  @@map("accounts")
}

model Tax {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  rate        Decimal
  type        String
  isInclusive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folioLines   FolioLine[]
  expenseLines ExpenseLine[]

  @@unique([tenantId, code])
  @@map("taxes")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, code])
  @@map("payment_methods")
}

model Folio {
  id         String    @id @default(cuid())
  tenantId   String
  propertyId String
  guestId    String?
  companyId  String?
  currencyId String
  type       String
  status     String    @default("open")
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  remarks    String?

  // Relations
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest    Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)
  company  Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  currency Currency    @relation(fields: [currencyId], references: [id])
  lines    FolioLine[]
  payments Payment[]

  @@index([tenantId, status])
  @@map("folios")
}

model FolioLine {
  id          String   @id @default(cuid())
  tenantId    String
  folioId     String
  postingDate DateTime @default(now())
  description String
  quantity    Decimal
  unitPrice   Decimal
  amount      Decimal
  isCredit    Boolean  @default(false)
  source      String?
  reference   String?
  taxId       String?
  taxAmount   Decimal?
  accountId   String?
  createdAt   DateTime @default(now())

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio   Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  tax     Tax?     @relation(fields: [taxId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([tenantId, postingDate])
  @@map("folio_lines")
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  folioId    String?
  amount     Decimal
  currencyId String
  methodId   String
  reference  String?
  externalId String?
  status     String   @default("completed")
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  // Relations
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio    Folio?        @relation(fields: [folioId], references: [id], onDelete: SetNull)
  currency Currency      @relation(fields: [currencyId], references: [id])
  method   PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([tenantId, status])
  @@map("payments")
}

model ExpenseVoucher {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String?
  supplierId  String?
  payeeName   String?
  date        DateTime @default(now())
  reference   String?
  status      String   @default("draft")
  currencyId  String
  subtotal    Decimal
  taxAmount   Decimal
  totalAmount Decimal
  costCenter  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  currency      Currency       @relation(fields: [currencyId], references: [id])
  lines         ExpenseLine[]
  pettyCashTxns PettyCashTxn[]

  @@index([tenantId, date])
  @@map("expense_vouchers")
}

model ExpenseLine {
  id          String   @id @default(cuid())
  tenantId    String
  voucherId   String
  accountId   String
  description String
  quantity    Decimal
  unitPrice   Decimal
  amount      Decimal
  taxId       String?
  taxAmount   Decimal?
  costCenter  String?
  createdAt   DateTime @default(now())

  // Relations
  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher ExpenseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  account Account        @relation(fields: [accountId], references: [id])
  tax     Tax?           @relation(fields: [taxId], references: [id])

  @@index([tenantId, voucherId])
  @@map("expense_lines")
}

model PettyCashFund {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  currencyId String
  balance    Decimal  @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currency     Currency       @relation(fields: [currencyId], references: [id])
  transactions PettyCashTxn[]

  @@unique([tenantId, name])
  @@map("petty_cash_funds")
}

model PettyCashTxn {
  id          String   @id @default(cuid())
  tenantId    String
  fundId      String
  type        String
  amount      Decimal
  date        DateTime @default(now())
  reference   String?
  description String?
  voucherId   String?

  // Relations
  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fund    PettyCashFund   @relation(fields: [fundId], references: [id], onDelete: Cascade)
  voucher ExpenseVoucher? @relation(fields: [voucherId], references: [id], onDelete: SetNull)

  @@index([tenantId, date])
  @@map("petty_cash_txns")
}

// ─── F&B / POS ────────────────────────────────────────────────────────────────

model FBMenuItem {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  description   String?
  category      String   // food | beverage | dessert | snack | special
  venue         String   // restaurant | bar | room_service | all
  route         String   @default("kitchen") // kitchen | bar
  unitPrice     Decimal
  costPrice     Decimal  @default(0)
  glAccountCode String   @default("4200")
  isAvailable   Boolean  @default(true)
  allergens     String?
  prepMinutes   Int      @default(10)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, venue])
  @@index([tenantId, category])
  @@map("fb_menu_items")
}

model FBOrder {
  id           String      @id @default(cuid())
  tenantId     String
  orderNumber  String
  venue        String      // restaurant | bar | room_service | pool_bar
  status       String      @default("pending") // pending | preparing | ready | served | cancelled | billed
  tableNumber  String?
  roomNumber   String?
  guestId      String?
  reservationId String?
  folioId      String?     // set when billed to folio
  serverName   String?
  covers       Int         @default(1)
  subtotal     Decimal     @default(0)
  taxAmount    Decimal     @default(0)
  total        Decimal     @default(0)
  taxLines     Json?       // stores per-tax breakdown: [{taxCode, name, rate, amount, glAccountCode}]
  discountAmount Decimal   @default(0)
  serviceCharge  Decimal   @default(0)
  notes        String?
  billedAt     DateTime?
  servedAt     DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  FBOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, guestId])
  @@index([tenantId, folioId])
  @@map("fb_orders")
}

model FBOrderItem {
  id          String   @id @default(cuid())
  tenantId    String
  orderId     String
  menuItemId  String?
  name        String
  category    String?
  quantity    Int
  unitPrice   Decimal
  amount      Decimal
  taxAmount   Decimal  @default(0)
  notes       String?
  glAccountCode String? @default("4200")
  createdAt   DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  FBOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@map("fb_order_items")
}

// ─── Housekeeping ─────────────────────────────────────────────────────────────

model HousekeepingTask {
  id           String    @id @default(cuid())
  tenantId     String
  roomId       String?
  roomNumber   String?
  taskType     String    // cleaning | inspection | turndown | maintenance | deep_clean
  status       String    @default("pending") // pending | in_progress | completed | skipped
  priority     String    @default("normal")  // low | normal | high | urgent
  assignedTo   String?
  assignedName String?
  notes        String?
  scheduledFor DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, roomId])
  @@index([tenantId, assignedTo])
  @@map("housekeeping_tasks")
}

model RoomStatusLog {
  id         String   @id @default(cuid())
  tenantId   String
  roomId     String
  roomNumber String
  fromStatus String
  toStatus   String
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId])
  @@index([tenantId, createdAt])
  @@map("room_status_logs")
}

model MaintenanceRequest {
  id           String    @id @default(cuid())
  tenantId     String
  roomId       String?
  roomNumber   String?
  location     String?
  category     String    // plumbing | electrical | hvac | furniture | appliance | other
  priority     String    @default("normal")
  status       String    @default("open") // open | in_progress | completed | cancelled
  description  String
  reportedBy   String?
  assignedTo   String?
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, roomId])
  @@map("maintenance_requests")
}
