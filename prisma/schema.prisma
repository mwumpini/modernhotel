  number    String
  capacity  Int
  section   String? // e.g. main floor | patio | bar
  status    String   @default("available") // available | occupied | reserved | cleaning
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reservations TableReservation[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@map("restaurant_tables")
}

model TableReservation {
  id               String    @id @default(cuid())
  tenantId         String
  customerName     String
  phone            String?
  tableId          String?
  reservationDate  DateTime
  time             String
  guests           Int       @default(1)
  status           String    @default("pending") // pending | confirmed | cancelled | completed
  specialRequests  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  table  RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, reservationDate])
  @@map("table_reservations")
}

model Recipe {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  category        String
  preparationTime Int      @default(0)
  difficulty      String   @default("medium") // easy | medium | hard
  allergens       String?  // comma-separated, matches FBMenuItem convention
  ingredients     Json     // [{ name, quantity, unit }]
  instructions    Json     // [string]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, category])
  @@map("recipes")
}
