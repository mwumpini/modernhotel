// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./test.db"
}

model Tenant {
  id            String   @id @default(cuid())
  name          String
  subdomain     String   @unique
  plan          String   @default("starter")
  status        String   @default("active")
  maxUsers      Int      @default(5)
  maxRooms      Int      @default(20)
  maxProperties Int      @default(1)
  features      Json
  metadata      Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  users             User[]
  properties        Property[]
  settings          SystemSettings[]
  guests            Guest[]
  reservations      Reservation[]
  auditLogs         AuditLog[]
  rooms             Room[]
  companies         Company[]
  suppliers         Supplier[]
  units             UnitOfMeasure[]
  itemCategories    ItemCategory[]
  inventoryItems    InventoryItem[]
  stockLocations    StockLocation[]
  currencies        Currency[]
  exchangeRates     ExchangeRate[]
  accounts          Account[]
  taxes             Tax[]
  folios            Folio[]
  folioLines        FolioLine[]
  payments          Payment[]
  paymentMethods    PaymentMethod[]
  expenseVouchers   ExpenseVoucher[]
  expenseLines      ExpenseLine[]
  pettyCashFunds    PettyCashFund[]
  pettyCashTxns     PettyCashTxn[]
  journalEntries    JournalEntry[]
  journalEntryLines JournalEntryLine[]
  accountingInvoices     AccountingInvoice[]
  accountingInvoiceLines AccountingInvoiceLine[]
  accountingPayments     AccountingPayment[]
  guestFolios            GuestFolio[]
  fbMenuItems            FBMenuItem[]
  fbOrders               FBOrder[]
  fbOrderItems           FBOrderItem[]
  housekeepingTasks      HousekeepingTask[]
  roomStatusLogs         RoomStatusLog[]
  maintenanceRequests    MaintenanceRequest[]
  housekeepingStaff      HousekeepingStaff[]
  purchaseOrders         PurchaseOrder[]
  purchaseOrderItems     PurchaseOrderItem[]
  bankReconciliations    BankReconciliation[]
  reconcilingItems       ReconcilingItem[]
  bankAccounts           BankAccount[]
  costCenters            CostCenter[]
  revenueCenters         RevenueCenter[]
  hrEmployees            HrEmployee[]
  hrDepartments          HrDepartment[]
  hrPositions            HrPosition[]
  hrPayrollPeriods       HrPayrollPeriod[]
  hrPayrollRecords       HrPayrollRecord[]
  hrLeaveRequests        HrLeaveRequest[]
  hrTrainingPrograms     HrTrainingProgram[]
  hrTrainingRecords      HrTrainingRecord[]
  guestServices          GuestService[]
  serviceRequests        ServiceRequest[]
  conferenceHalls        ConferenceHall[]
  cateringItems          CateringItem[]
  eventBookings          EventBooking[]
  restaurantTables       RestaurantTable[]
  tableReservations      TableReservation[]
  recipes                Recipe[]
  inventoryTransactions  InventoryTransaction[]

  @@map("tenants")
}

model User {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  name        String
  password    String?
  role        String    @default("user")
  permissions Json      @default("[]")
  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model Property {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  address    String
  city       String
  state      String
  country    String   @default("Ghana")
  postalCode String?
  phone      String?
  email      String?
  website    String?
  timezone   String   @default("Africa/Accra")
  currency   String   @default("GHS")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rooms           Room[]
  stockLocations  StockLocation[]
  folios          Folio[]
  expenseVouchers ExpenseVoucher[]

  @@unique([tenantId, name])
  @@map("properties")
}

model Guest {
  id           String  @id @default(cuid())
  tenantId     String
  serialNumber String  @unique
  name         String
  firstName    String?
  lastName     String?
  email        String?
  phone        String?
  nationality  String?
  ghanaCard    String?
  idType       String?
  idNumber     String?
  vipStatus    String?

  // Long-tail fields (preferences, emergencyContact, address, billing contact,
  // credit fields, dateOfBirth, gender, etc.)
  details Json?

  // Relations
  reservations Reservation[]
  folios       Folio[]

  // Marketing attribution
  source          String?
  referralGuestId String?
  referralName    String?
  socialPlatform  String?
  socialHandle    String?
  campaignCode    String?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("guests")
}

model Reservation {
  id              String   @id @default(cuid())
  tenantId        String
  guestId         String
  resId           String?
  roomType        String?
  ratePlanId      String?
  roomId          String?
  status          String   @default("pending")
  source          String?
  checkInDate     DateTime
  checkOutDate    DateTime
  adults          Int      @default(1)
  children        Int      @default(0)
  specialRequests String?

  // Hybrid: queryable/reportable columns
  stayReason          String?
  isGuaranteed        Boolean @default(false)
  billingPersonId     String?
  companyName         String?
  groupId             String?
  isGroupLeader       Boolean @default(false)
  linkedReservationId String?
  groupSize           Int?
  totalAmount         Float?

  // Long-tail fields (rateBreakdown, marketCodes, internalNotes, remarksToGuest,
  // projectCode, costCenter, stayReasonDetails, etc.)
  details Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  guest  Guest  @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, checkInDate])
  @@index([tenantId, guestId])
  @@index([tenantId, roomId])
  @@index([tenantId, groupId])
  @@map("reservations")
}

model JournalEntry {
  id                  String    @id @default(cuid())
  tenantId            String
  entryNumber         String
  date                DateTime
  reference           String?
  description         String?
  totalDebit          Float     @default(0)
  totalCredit         Float     @default(0)
  currency            String    @default("GHS")
  exchangeRate        Float?
  status              String    @default("Draft")
  postedBy            String?
  postedAt            DateTime?
  sourceModule        String?
  sourceTransactionId String?
  details             Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  JournalEntryLine[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, sourceModule])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String  @id @default(cuid())
  tenantId       String
  journalEntryId String
  accountCode    String
  description    String?
  debit          Float   @default(0)
  credit         Float   @default(0)
  currency       String  @default("GHS")
  exchangeRate   Float?
  taxCode        String?
  taxAmount      Float?
  department     String?
  project        String?
  costCenter     String?
  reference      String?
  details        Json?

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  journalEntry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)

  @@index([tenantId, journalEntryId])
  @@index([tenantId, accountCode])
  @@map("journal_entry_lines")
}

model AccountingInvoice {
  id                String    @id @default(cuid())
  tenantId          String
  invoiceNumber     String
  type              String    @default("Sales")
  date              DateTime
  dueDate           DateTime?
  businessPartnerId String?
  reference         String?
  description       String?
  subtotal          Float     @default(0)
  taxAmount         Float     @default(0)
  total             Float     @default(0)
  currency          String    @default("GHS")
  exchangeRate      Float?
  status            String    @default("Draft")
  paidAmount        Float     @default(0)
  paidDate          DateTime?
  journalEntryId    String?
  sourceModule      String?
  details           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  AccountingInvoiceLine[]

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, businessPartnerId])
  @@map("accounting_invoices")
}

model AccountingInvoiceLine {
  id            String  @id @default(cuid())
  tenantId      String
  invoiceId     String
  itemCode      String?
  description   String?
  quantity      Float   @default(0)
  unitPrice     Float   @default(0)
  amount        Float   @default(0)
  taxCode       String?
  taxAmount     Float   @default(0)
  glAccountCode String?
  costCenter    String?
  project       String?
  uom           String?
  taxRate       Float?
  details       Json?

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice AccountingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("accounting_invoice_lines")
}

model AccountingPayment {
  id                String    @id @default(cuid())
  tenantId          String
  paymentNumber     String
  date              DateTime
  type              String    @default("Receipt")
  businessPartnerId String?
  invoiceId         String?
  reference         String?
  description       String?
  amount            Float     @default(0)
  currency          String    @default("GHS")
  exchangeRate      Float?
  paymentMethod     String?
  bankAccountId     String?
  checkNumber       String?
  status            String    @default("Draft")
  journalEntryId    String?
  details           Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, invoiceId])
  @@map("accounting_payments")
}

// Front-office guest folio (in-house subledger). The store's Folio carries a
// small set of scalar fields plus charge/payment arrays that mutate frequently;
// arrays live in JSON columns so each folio is a single, atomically-upserted row.
// Named GuestFolio to avoid colliding with the legacy normalized Folio model.
model GuestFolio {
  id               String   @id
  tenantId         String
  reservationId    String
  currency         String   @default("GHS")
  status           String   @default("active")
  type             String?
  description      String?
  responsibleParty String?
  creditBalance    Float?
  totalCharges     Float    @default(0)
  totalPayments    Float    @default(0)
  balance          Float    @default(0)
  charges          Json?
  payments         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, reservationId])
  @@index([tenantId, status])
  @@map("guest_folios")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, action])
  @@map("audit_logs")
}

model SystemSettings {
  id       String @id @default(cuid())
  tenantId String @unique

  // General settings
  generalSettings Json

  // Hotel settings
  hotelSettings Json

  // Room settings
  roomSettings Json

  // Financial settings
  financialSettings Json

  // Client settings
  clientSettings Json

  // SaaS settings
  saasSettings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("system_settings")
}

model Room {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String
  roomNumber String
  roomType   String
  floor      Int
  features   Json
  status     String   @default("clean")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([tenantId, propertyId, roomNumber])
  @@map("rooms")
}

model Company {
  id             String   @id @default(cuid())
  tenantId       String
  code           String
  name           String
  email          String?
  phone          String?
  taxNumber      String?
  billingAddress Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folios Folio[]

  @@unique([tenantId, code])
  @@map("companies")
}

model Supplier {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  email         String?
  phone         String?
  contactPerson String?
  taxNumber     String?
  address       Json?
  // Long-tail fields the Inventory & Stores supplier form collects that don't have
  // their own column: { city, country, postalCode, paymentTerms, creditLimit,
  // currentBalance, rating, categories, contractStartDate, contractEndDate, performance }
  details       Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expenseVouchers ExpenseVoucher[]
  inventoryItems  InventoryItem[]

  @@unique([tenantId, code])
  @@map("suppliers")
}

model UnitOfMeasure {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  precision Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  InventoryItem[]

  @@unique([tenantId, code])
  @@map("units")
}

model ItemCategory {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ItemCategory?   @relation("CategoryToParent", fields: [parentId], references: [id])
  children ItemCategory[]  @relation("CategoryToParent")
  items    InventoryItem[]

  @@unique([tenantId, code])
  @@map("item_categories")
}

model InventoryItem {
  id             String   @id @default(cuid())
  tenantId       String
  code           String
  name           String
  description    String?
  categoryId     String?
  unitId         String?
  isPerishable   Boolean  @default(false)
  isSerialized   Boolean  @default(false)
  barcode        String?
  defaultCost    Decimal?
  sellingPrice   Decimal?
  quantityOnHand Decimal  @default(0)
  reorderLevel   Decimal  @default(0)
  minimumStock   Decimal  @default(0)
  maximumStock   Decimal  @default(0)
  location       String?
  supplierId     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category     ItemCategory?          @relation(fields: [categoryId], references: [id])
  unit         UnitOfMeasure?         @relation(fields: [unitId], references: [id])
  supplier     Supplier?              @relation(fields: [supplierId], references: [id])
  transactions InventoryTransaction[]

  @@unique([tenantId, code])
  @@map("inventory_items")
}

model StockLocation {
  id         String   @id @default(cuid())
  tenantId   String
  propertyId String?
  code       String
  name       String
  type       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  tenant       Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property     Property?              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  transactions InventoryTransaction[]

  @@unique([tenantId, code])
  @@map("stock_locations")
}

// Append-only audit trail of every stock movement. InventoryItem.quantityOnHand
// is the running total this log produces — always write both together in one
// transaction so the two never drift apart.
model InventoryTransaction {
  id            String   @id @default(cuid())
  tenantId      String
  itemId        String
  locationId    String?
  type          String   // receipt | issue | transfer_in | transfer_out | adjustment | count
  quantity      Decimal  // signed: positive adds to stock, negative removes
  unitCost      Decimal?
  referenceType String?  // purchase_order | requisition | transfer | stock_count | manual
  referenceId   String?
  notes         String?
  performedBy   String?
  createdAt     DateTime @default(now())

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  item     InventoryItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location StockLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([tenantId, itemId])
  @@index([tenantId, createdAt])
  @@map("inventory_transactions")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Currency {
  id            String   @id @default(cuid())
  tenantId      String
  code          String
  name          String
  symbol        String?
  decimalPlaces Int      @default(2)
  isBase        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  tenant            Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  exchangeRatesFrom ExchangeRate[]   @relation("ExchangeFrom")
  exchangeRatesTo   ExchangeRate[]   @relation("ExchangeTo")
  folios            Folio[]
  payments          Payment[]
  expenseVouchers   ExpenseVoucher[]
  pettyCashFunds    PettyCashFund[]

  @@unique([tenantId, code])
  @@map("currencies")
}

model ExchangeRate {
  id             String   @id @default(cuid())
  tenantId       String
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal
  validFrom      DateTime
  createdAt      DateTime @default(now())

  // Relations
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromCurrency Currency @relation("ExchangeFrom", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ExchangeTo", fields: [toCurrencyId], references: [id])

  @@unique([tenantId, fromCurrencyId, toCurrencyId, validFrom])
  @@index([tenantId, validFrom])
  @@map("exchange_rates")
}

model Account {
  id        String      @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      AccountType
  /** Full client-side CoaAccountType (e.g. "Cost of Sales", "Operating Expense", "Contra") —
   *  `type` above is the coarser 5-value rollup used elsewhere; this preserves the exact
   *  tree-editor type so it round-trips losslessly. Falls back to `type` when unset. */
  category  String?
  /** Sibling display order within the same parent. */
  position  Int         @default(0)
  parentId  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountParent", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountParent")
  folioLines   FolioLine[]
  expenseLines ExpenseLine[]

  @@unique([tenantId, code])
  @@map("accounts")
}

model BankAccount {
  id                 String   @id @default(cuid())
  tenantId           String
  accountNumber      String
  accountName        String
  bankName           String
  branch             String?
  swiftCode          String?
  iban               String?
  currency           String   @default("GHS")
  glAccountCode      String
  /** "go_live" posts opening balance to GL (Dr bank / Cr equity); "period" is register/reconciliation only. */
  openingBalanceType String?
  openingBalance     Float    @default(0)
  currentBalance     Float    @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model CostCenter {
  id             String   @id @default(cuid())
  tenantId       String
  code           String
  name           String
  description    String?
  type           String
  department     String
  /** Expense GL account this cost centre rolls up from — optional; unset means the legacy
   *  `actualExpenses` counter (recordExpense) is the only source of that figure. */
  glAccountCode  String?
  parentCenter   String?
  manager        String?
  budget         Float    @default(0)
  actualExpenses Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("cost_centers")
}

model RevenueCenter {
  id             String   @id @default(cuid())
  tenantId       String
  code           String
  name           String
  description    String?
  type           String
  department     String
  glAccountCode  String
  parentCenter   String?
  manager        String?
  budget         Float    @default(0)
  actualRevenue  Float    @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("revenue_centers")
}

model Tax {
  id          String   @id @default(cuid())
  tenantId    String
  code        String
  name        String
  rate        Decimal
  type        String
  isInclusive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folioLines   FolioLine[]
  expenseLines ExpenseLine[]

  @@unique([tenantId, code])
  @@map("taxes")
}

model PaymentMethod {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  type      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([tenantId, code])
  @@map("payment_methods")
}

model Folio {
  id         String    @id @default(cuid())
  tenantId   String
  propertyId String
  guestId    String?
  companyId  String?
  currencyId String
  type       String
  status     String    @default("open")
  openedAt   DateTime  @default(now())
  closedAt   DateTime?
  remarks    String?

  // Relations
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property Property    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guest    Guest?      @relation(fields: [guestId], references: [id], onDelete: SetNull)
  company  Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  currency Currency    @relation(fields: [currencyId], references: [id])
  lines    FolioLine[]
  payments Payment[]

  @@index([tenantId, status])
  @@map("folios")
}

model FolioLine {
  id          String   @id @default(cuid())
  tenantId    String
  folioId     String
  postingDate DateTime @default(now())
  description String
  quantity    Decimal
  unitPrice   Decimal
  amount      Decimal
  isCredit    Boolean  @default(false)
  source      String?
  reference   String?
  taxId       String?
  taxAmount   Decimal?
  accountId   String?
  createdAt   DateTime @default(now())

  // Relations
  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio   Folio    @relation(fields: [folioId], references: [id], onDelete: Cascade)
  tax     Tax?     @relation(fields: [taxId], references: [id])
  account Account? @relation(fields: [accountId], references: [id])

  @@index([tenantId, postingDate])
  @@map("folio_lines")
}

model Payment {
  id         String   @id @default(cuid())
  tenantId   String
  folioId    String?
  amount     Decimal
  currencyId String
  methodId   String
  reference  String?
  externalId String?
  status     String   @default("completed")
  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  // Relations
  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folio    Folio?        @relation(fields: [folioId], references: [id], onDelete: SetNull)
  currency Currency      @relation(fields: [currencyId], references: [id])
  method   PaymentMethod @relation(fields: [methodId], references: [id])

  @@index([tenantId, status])
  @@map("payments")
}

model ExpenseVoucher {
  id          String   @id @default(cuid())
  tenantId    String
  propertyId  String?
  supplierId  String?
  payeeName   String?
  date        DateTime @default(now())
  reference   String?
  status      String   @default("draft")
  currencyId  String
  subtotal    Decimal
  taxAmount   Decimal
  totalAmount Decimal
  costCenter  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  property      Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  supplier      Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  currency      Currency       @relation(fields: [currencyId], references: [id])
  lines         ExpenseLine[]
  pettyCashTxns PettyCashTxn[]

  @@index([tenantId, date])
  @@map("expense_vouchers")
}

model ExpenseLine {
  id          String   @id @default(cuid())
  tenantId    String
  voucherId   String
  accountId   String
  description String
  quantity    Decimal
  unitPrice   Decimal
  amount      Decimal
  taxId       String?
  taxAmount   Decimal?
  costCenter  String?
  createdAt   DateTime @default(now())

  // Relations
  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voucher ExpenseVoucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
