// Field names/status vocabulary deliberately match src/app/lib/inventory/models.ts's
// PurchaseOrder/PurchaseOrderItem (the shape the actual UI in supplierStore.ts uses),
// not a generic invented shape — so the store's create/update calls map 1:1 with no
// lossy translation layer.
model PurchaseOrder {
  id                   String    @id @default(cuid())
  tenantId             String
  poNumber             String
  // Loose reference to the inventory module's Supplier record (currently a separate
  // in-memory store, not this schema's Supplier table) — not a Prisma FK on purpose.
  supplierId           String
  supplierName         String
  orderDate            DateTime  @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  status               String    @default("draft") // draft|sent|confirmed|in-transit|delivered|cancelled|closed
  priority             String    @default("medium") // low|medium|high|urgent
  totalAmount          Decimal   @default(0) // pre-tax/shipping/discount subtotal
  taxAmount            Decimal   @default(0)
  shippingAmount       Decimal   @default(0)
  discountAmount       Decimal   @default(0)
  finalAmount          Decimal   @default(0)
  currency             String    @default("GHS")
  paymentTerms         String?
  notes                String?
  createdBy            String?
  approvedBy           String?
  approvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  PurchaseOrderItem[]

  @@unique([tenantId, poNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid())
  tenantId         String
  purchaseOrderId  String
  itemId           String
  itemCode         String
  itemName         String
  quantity         Decimal
  unitCost         Decimal
  totalCost        Decimal
  receivedQuantity Decimal  @default(0)
  notes            String?
  createdAt        DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, purchaseOrderId])
  @@map("purchase_order_items")
}

model BankReconciliation {
  id               String    @id @default(cuid())
  tenantId         String
  bankAccountId    String
  periodEndDate    DateTime
  statementBalance Decimal   @default(0)
  cashbookBalance  Decimal   @default(0)
  status           String    @default("Draft") // Draft | Completed | Approved
  preparedAt       DateTime?
  approvedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items  ReconcilingItem[]

  @@unique([tenantId, bankAccountId, periodEndDate])
  @@index([tenantId, bankAccountId])
  @@map("bank_reconciliations")
}

model ReconcilingItem {
  id                String    @id @default(cuid())
  tenantId          String
  reconciliationId  String
  itemType          String
  description       String
  reference         String?
  transactionDate   DateTime?
  amount            Decimal
  isCleared         Boolean   @default(false)
  clearedDate       DateTime?
  journalEntryId    String?
  offsetGlCode      String?
  carriedFromItemId String?
  createdAt         DateTime  @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reconciliation BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  @@index([tenantId, reconciliationId])
  @@map("reconciling_items")
}

// ---------------------------------------------------------------------------
// HR & Payroll — field names match src/app/lib/hr/models.ts. Nested/evolving
// structures (bank account, emergency contact, address, tax withholding,
// government IDs, qualifications, acknowledgments, probation, next of kin,
// leave entitlement overrides) live in `details Json`, following the same
// long-tail-column pattern used in src/app/lib/frontoffice/repository.ts.
// ---------------------------------------------------------------------------

model HrEmployee {
  id                    String    @id @default(cuid())
  tenantId              String
  employeeNumber        String
  firstName             String
  lastName              String
  email                 String
  phone                 String
  gender                String?
  nationality           String?
  maritalStatus         String?
  dateOfBirth           DateTime
  hireDate              DateTime
  terminationDate       DateTime?
  departmentId          String?
  positionId            String?
  managerId             String?
  workLocation          String?
  employmentType        String    @default("full_time")
  status                String    @default("active")
  residencyStatus       String?
  employmentClass       String?
  secondEmployment      Boolean   @default(false)
  incomeTaxDeductible   Boolean   @default(true)
  ssnitEnrolled         Boolean   @default(false)
  tier2Enrolled         Boolean   @default(false)
  tier3Enrolled         Boolean   @default(false)
  tier3ContributionPct  Decimal   @default(0)
  salary                Decimal   @default(0)
  hourlyRate            Decimal?
  overtimeRate          Decimal?
  compensationType      String?
  basicSalary           Decimal?
  allowances            Decimal?
  paymentFrequency      String?
  ssnitNumber           String?
  ghanaCardNumber       String?
  contractEndDate       DateTime?
  workPermitExpiryDate  DateTime?
  photo                 String?
  vehicleBenefit        Decimal   @default(0)
  housingBenefit        Decimal   @default(0)
  otherNonCashBenefits  Decimal   @default(0)
  notes                 String?
  details               Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, employeeNumber])
  @@index([tenantId, status])
  @@index([tenantId, departmentId])
  @@map("hr_employees")
}

model HrDepartment {
  id                  String   @id @default(cuid())
  tenantId            String
  name                String
  code                String?
  description         String?
  managerId           String?
  parentDepartmentId  String?
  budget              Decimal  @default(0)
  location            String?
  isActive            Boolean  @default(true)
  status              String   @default("active")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("hr_departments")
}

model HrPosition {
  id               String   @id @default(cuid())
  tenantId         String
  title            String
  code             String?
  departmentId     String
  description      String?
  requirements     Json?
  responsibilities Json?
  minSalary        Decimal?
  maxSalary        Decimal?
  baseSalary       Decimal?
  isActive         Boolean  @default(true)
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, departmentId])
  @@map("hr_positions")
}

model HrPayrollPeriod {
  id              String    @id @default(cuid())
  tenantId        String
  periodNumber    String
  startDate       DateTime
  endDate         DateTime
  status          String    @default("draft") // draft|processing|approved|paid|closed
  totalGrossPay   Decimal   @default(0)
  totalNetPay     Decimal   @default(0)
  totalDeductions Decimal   @default(0)
  totalTaxes      Decimal   @default(0)
  employeeCount   Int       @default(0)
  processedBy     String?
  processedAt     DateTime?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
