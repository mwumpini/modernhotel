  @@unique([tenantId, periodNumber])
  @@index([tenantId, status])
  @@map("hr_payroll_periods")
}

model HrPayrollRecord {
  id              String    @id @default(cuid())
  tenantId        String
  payrollPeriodId String
  employeeId      String
  employeeNumber  String
  employeeName    String
  department      String?
  position        String?
  basicSalary     Decimal   @default(0)
  allowances      Decimal   @default(0)
  overtimePay     Decimal   @default(0)
  bonuses         Decimal   @default(0)
  grossPay        Decimal   @default(0)
  // { tax, socialSecurity, healthInsurance, pension, other } — see HrPayrollRecord's
  // deductions shape in src/app/lib/hr/models.ts.
  deductions      Json
  netPay          Decimal   @default(0)
  bankAccount     String?
  paymentMethod   String    @default("bank_transfer")
  status          String    @default("pending") // pending|processed|paid|failed
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
