}

model MaintenanceRequest {
  id           String    @id @default(cuid())
  tenantId     String
  roomId       String?
  roomNumber   String?
  location     String?
  category     String    // plumbing | electrical | hvac | furniture | appliance | other
  priority     String    @default("normal")
  status       String    @default("open") // open | in_progress | completed | cancelled
  description  String
  reportedBy   String?
  assignedTo   String?
  estimatedCost Decimal?
  actualCost    Decimal?
  resolvedAt   DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

